# Riot API key — server-side only.
# Never prefix with NEXT_PUBLIC_; that would ship the key to the browser.
# Get a key at https://developer.riotgames.com/
RIOT_API_KEY=

# Routing is fixed in code (platform na1 / region americas): this is an NA event.

# Neon Postgres connection string — server-side only.
# Holds NTGI match history (and nothing else). Never prefix with NEXT_PUBLIC_.
# Create a database at https://neon.tech and paste its pooled connection string.
# Example shape (NOT a real database):
#   postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# Leaving this empty is safe: the leaderboard still renders, without champions.
DATABASE_URL=
